{
    "compilerOptions": {
        "target": "ESNext",
        "useUnknownInCatchVariables": false,
        "module": "ESNext",
        "moduleResolution": "Node",
        "strict": true,
        "jsx": "preserve",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "lib": ["ESNext", "DOM"],
        "skipLibCheck": true,
        "outDir": "public/build",
        "types": ["node"],
        "baseUrl": ".",
        "paths": {
            "@/*": ["resources/js/*"]
        }
    },
    "include": [
        "resources/**/*",
        "vite.config.*"
    ],
    "exclude": [
        "node_modules",
        "vendor"
    ]
}
